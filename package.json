{
  "name": "@avee1234/agentroute",
  "version": "0.2.1",
  "private": false,
  "description": "Portable, auditable model-routing receipts and replay analytics.",
  "keywords": [
    "ai",
    "llm",
    "model-routing",
    "observability",
    "openrouter",
    "provenance"
  ],
  "homepage": "https://abhid1234.github.io/AgentRoute/",
  "bugs": {
    "url": "https://github.com/abhid1234/AgentRoute/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/abhid1234/AgentRoute.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "route-conformance/",
    "schema/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "ar": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx test/route.ts",
    "conformance": "node route-conformance/check.mjs",
    "test:examples": "node examples/connectors/sample-gateway-adapter.mjs",
    "test:action": "node scripts/check-proof-action.mjs && node scripts/check-gate-action.mjs",
    "test:package": "node scripts/check-registry-version.test.mjs && node scripts/check-package.mjs",
    "verify": "npm run build && npm test && npm run conformance && npm run test:examples && npm run test:action && npm run test:package",
    "demo:report": "node dist/cli.js report examples/can-auto-routing-prove-it.route.jsonl"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^7.0.2",
    "yaml": "^2.9.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
