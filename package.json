{
  "name": "agentroute",
  "version": "0.2.0",
  "private": true,
  "description": "Portable, auditable model-routing receipts and replay analytics.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "route-conformance/",
    "schema/",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "bin": {
    "ar": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx test/route.ts",
    "conformance": "node route-conformance/check.mjs",
    "test:examples": "node examples/connectors/sample-gateway-adapter.mjs",
    "test:package": "node scripts/check-package.mjs",
    "verify": "npm run build && npm test && npm run conformance && npm run test:examples && npm run test:package",
    "demo:report": "node dist/cli.js report examples/can-auto-routing-prove-it.route.jsonl"
  },
  "devDependencies": {
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
